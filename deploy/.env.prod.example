# ZeroFake production configuration.
#
#   cp deploy/.env.prod.example .env
#
# Lives at the repository root as .env, which is git-ignored. Every value
# marked REQUIRED has no default: the stack refuses to start without it, by
# design, because every one of them is a way to accidentally deploy something
# insecure.

# ---------------------------------------------------------------------------
# REQUIRED — the public origin
# ---------------------------------------------------------------------------
# Scheme and host, no trailing slash. Used for CORS, and it must match how
# users actually reach the site or logins will fail.
#
#   https://zerofake.example.com     with a domain and TLS
#   http://203.0.113.10              IP only, no TLS  (development only)
PUBLIC_URL=

# ---------------------------------------------------------------------------
# REQUIRED — JWT signing key
# ---------------------------------------------------------------------------
# Generate a fresh one. Never reuse the development key from .env.example.
#
#   openssl rand -base64 64 | tr -d '[:space:]'
JWT_SECRET=

JWT_ISSUER=zerofake-auth-service
JWT_ACCESS_TOKEN_EXPIRATION=900000
JWT_REFRESH_TOKEN_EXPIRATION=604800000

# ---------------------------------------------------------------------------
# REQUIRED — database
# ---------------------------------------------------------------------------
# The database port is not published, so this password only protects against
# an attacker who already has a foothold on the host. Set it properly anyway.
#
#   openssl rand -base64 24 | tr -d '[:space:]'
DB_USERNAME=zerofake
DB_PASSWORD=

# ---------------------------------------------------------------------------
# REQUIRED — demonstration accounts
# ---------------------------------------------------------------------------
# The seeder creates one account per role, including an administrator.
#
# For a public demo, set a strong password here. The one in .env.example is
# published in this repository; using it on an internet-facing deployment
# hands anyone administrator access.
#
# For anything holding real data, set SEED_ENABLED=false and create the first
# administrator manually.
SEED_ENABLED=true
SEED_DEFAULT_PASSWORD=

# ---------------------------------------------------------------------------
# REQUIRED — Hyperledger Fabric
# ---------------------------------------------------------------------------
# Printed by deploy/setup-fabric.sh when it finishes. Absolute path to the
# Org1 peer organisation directory.
FABRIC_CRYPTO_PATH=

FABRIC_MSP_ID=Org1MSP
FABRIC_CHANNEL_NAME=mychannel
FABRIC_CHAINCODE_NAME=zerofake
FABRIC_PEER_HOST_ALIAS=peer0.org1.example.com

# Fabric runs on the host; containers reach it through the host gateway.
FABRIC_PEER_ENDPOINT=dns:///host.docker.internal:7051

# ---------------------------------------------------------------------------
# Diagnostics
# ---------------------------------------------------------------------------
# Leave ddl-auto at validate once the schema is stable, so a code change can
# never silently reshape a database holding real data.
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
SQL_LOG_LEVEL=WARN
