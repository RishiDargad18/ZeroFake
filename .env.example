# ZeroFake environment configuration
#
#   cp .env.example .env
#
# .env is git-ignored. Never commit real secrets.

# ---------------------------------------------------------------------------
# JWT
# ---------------------------------------------------------------------------
# Base64-encoded HMAC-SHA key, shared by every service. The authentication
# service signs tokens with it; the others validate against it.
#
# Generate a fresh one:
#   openssl rand -base64 64 | tr -d '[:space:]'
#
# Strip all whitespace, not just newlines: on Windows shells openssl emits
# CRLF, and a stray carriage return makes the key fail to decode.
#
# REQUIRED. docker compose refuses to start without it.
JWT_SECRET=

JWT_ISSUER=zerofake-auth-service
JWT_ACCESS_TOKEN_EXPIRATION=900000
JWT_REFRESH_TOKEN_EXPIRATION=604800000

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_PORT=5432

# ---------------------------------------------------------------------------
# Demonstration accounts
# ---------------------------------------------------------------------------
# One account is seeded per role: admin@zerofake.com, manufacturer@zerofake.com,
# warehouse@, distributor@, retailer@, customer@ — all with this password.
SEED_DEFAULT_PASSWORD=Password123!
SEED_ENABLED=true

# ---------------------------------------------------------------------------
# Hyperledger Fabric
# ---------------------------------------------------------------------------
# Absolute path to the Org1 peer organisation directory of your Fabric network:
#   <fabric-samples>/test-network/organizations/peerOrganizations/org1.example.com
#
# Linux / macOS:
#   FABRIC_CRYPTO_PATH=/home/you/hyperledger/fabric-samples/test-network/organizations/peerOrganizations/org1.example.com
#
# Windows running Fabric under WSL2 (path as seen from Windows):
#   FABRIC_CRYPTO_PATH=\\wsl$\Ubuntu\home\you\hyperledger\fabric-samples\test-network\organizations\peerOrganizations\org1.example.com
#
# Inside WSL, or when running the service in Docker:
#   FABRIC_CRYPTO_PATH=/mnt/.../org1.example.com
FABRIC_CRYPTO_PATH=

FABRIC_MSP_ID=Org1MSP
FABRIC_CHANNEL_NAME=mychannel
FABRIC_CHAINCODE_NAME=zerofake
FABRIC_PEER_HOST_ALIAS=peer0.org1.example.com

# Running the services directly on the host:
#   FABRIC_PEER_ENDPOINT=dns:///localhost:7051
# Running them under docker compose, with the peer on the host:
#   FABRIC_PEER_ENDPOINT=dns:///host.docker.internal:7051
FABRIC_PEER_ENDPOINT=dns:///localhost:7051

# ---------------------------------------------------------------------------
# Web
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
FRONTEND_PORT=3000

VITE_AUTH_API=http://localhost:8081
VITE_PRODUCT_API=http://localhost:8082
VITE_BLOCKCHAIN_API=http://localhost:8083
VITE_FRAUD_API=http://localhost:8085

# ---------------------------------------------------------------------------
# Diagnostics
# ---------------------------------------------------------------------------
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
SQL_LOG_LEVEL=INFO
